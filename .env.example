# Salin ke .env lalu sesuaikan. Jangan commit .env.

# MySQL 8. Contoh Laragon lokal (user root tanpa password):
DATABASE_URL="mysql://root:@localhost:3306/prodi_arsitektur"

# Hanya dipakai oleh `npm run db:seed` untuk membuat akun admin awal.
# Wajib diisi; seed menolak berjalan tanpa keduanya.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Alamat publik situs (untuk sitemap, Open Graph, JSON-LD). Tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opsional: folder penyimpanan file unggahan. Default: ./storage/uploads
# Di server production arahkan ke volume yang dicadangkan, mis. /var/lib/arsitektur/uploads
# UPLOAD_DIR=""
